# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
*.egg

# Project runtime
# Leading slash anchors these to the repo root so they only ignore the runtime
# data dirs, NOT source packages like src/creator_agent/storage/.
/storage/
/logs/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test databases
*.db

# Episode splitter scratch dirs (scripts/split_episode.py)
/input/
/output/

# Character material library: images are large/local-only; manifests (JSONL
# index) and the directory skeleton stay in git.
/character_library/inbox/
/character_library/previews/
/character_library/analysis/
/character_library/characters/*/*.jpg
/character_library/characters/*/*.jpeg
/character_library/characters/*/*.png
