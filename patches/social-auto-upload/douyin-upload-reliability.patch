+    @staticmethod
+    async def _upload_status_text(page: Page) -> str:
+        try:
+            text = await page.locator("div.progress-div").last.inner_text(timeout=1000)
+            return " ".join(text.split())[:500]
+        except Exception:
+            return ""
+
+    async def _save_upload_failure_screenshot(self, page: Page, attempt: int) -> Path | None:
+        path = BASE_DIR / "logs" / f"douyin_upload_failure_{datetime.now():%Y%m%d_%H%M%S}_{attempt}.png"
+        try:
+            await page.screenshot(path=str(path), full_page=True)
+            return path
+        except Exception as exc:
+            douyin_logger.warning(_msg("⚠️", f"上传失败截图保存失败: {exc}"))
+            return None
+
+    @staticmethod
+    def _attach_upload_network_logging(page: Page) -> None:
+        """记录上传请求的底层网络错误；签名 URL 去掉 query，避免泄露临时凭证。"""
+
+        def is_upload_url(url: str) -> bool:
+            return "upload" in url.lower() or "douyinvod" in url.lower()
+
+        def on_request_failed(request) -> None:
+            if is_upload_url(request.url):
+                douyin_logger.error(
+                    _msg("🌐", f"上传网络请求失败: {request.failure}；{request.url.split('?', 1)[0]}")
+                )
+
+        def on_response(response) -> None:
+            if response.status >= 400 and is_upload_url(response.url):
+                douyin_logger.error(
+                    _msg("🌐", f"上传服务返回 HTTP {response.status}；{response.url.split('?', 1)[0]}")
+                )
+
+        page.on("requestfailed", on_request_failed)
+        page.on("response", on_response)
+
+    async def _wait_for_video_upload(self, page: Page) -> None:
+        """等待视频上传，输出页面真实进度；失败有界重试，不静默无限循环。"""
+        loop = asyncio.get_running_loop()
+        deadline = loop.time() + DOUYIN_UPLOAD_TIMEOUT_SECONDS
+        next_progress_log = 0.0
+        failed_attempts = 0
+
+        while True:
+            if loop.time() >= deadline:
+                raise TimeoutError(f"等待抖音视频上传超过 {DOUYIN_UPLOAD_TIMEOUT_SECONDS // 60} 分钟，已停止发布")
+
+            uploaded = page.locator('[class*="long-card"] div:has-text("重新上传")')
+            if await uploaded.count() > 0:
+                douyin_logger.success(_msg("🥳", "视频已经传完啦"))
+                return
+
+            failed = page.locator('div.progress-div > div:has-text("上传失败")')
+            if await failed.count() > 0:
+                failed_attempts += 1
+                detail = await self._upload_status_text(page) or "页面未给出具体原因"
+                screenshot = await self._save_upload_failure_screenshot(page, failed_attempts)
+                screenshot_hint = f"；截图: {screenshot}" if screenshot else ""
+                douyin_logger.error(
+                    _msg(
+                        "😵",
+                        f"第 {failed_attempts}/{DOUYIN_UPLOAD_MAX_ATTEMPTS} 次上传失败: {detail}{screenshot_hint}",
+                    )
+                )
+                if failed_attempts >= DOUYIN_UPLOAD_MAX_ATTEMPTS:
+                    raise RuntimeError(
+                        f"抖音视频连续上传失败 {failed_attempts} 次，已停止重试。"
+                        f"页面提示: {detail}。请用 --headed 重跑查看进度条，并检查上述失败详情。"
+                    )
+                await self.handle_upload_error(page)
+                # 等旧的“上传失败”状态清掉，避免把同一次失败重复计数。
+                try:
+                    await failed.first.wait_for(state="hidden", timeout=10000)
+                except Exception:
+                    pass
+                continue
+
+            now = loop.time()
+            if now >= next_progress_log:
+                status = await self._upload_status_text(page)
+                douyin_logger.info(_msg("🏃", f"视频上传状态: {status}" if status else "小人正在努力上传视频"))
+                next_progress_log = now + DOUYIN_UPLOAD_PROGRESS_INTERVAL_SECONDS
+            await asyncio.sleep(2)
 
